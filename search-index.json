---
layout: null
---
{% assign search_items = site.docs | concat: site.posts %}
[
  {
    "title": "Nox — トップページ",
    "section": "ページ",
    "url": {{ "/" | relative_url | jsonify }},
    "content": {{ site.description | strip_newlines | jsonify }}
  }{% if search_items.size > 0 %},{% endif %}
{% for item in search_items %}
  {
    "title": {{ item.title | jsonify }},
    "section": {% if item.collection == "posts" %}"ブログ"{% else %}"ドキュメント"{% endif %},
    "url": {{ item.url | relative_url | jsonify }},
    "content": {{ item.content | strip_html | strip_newlines | replace: '  ', ' ' | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
